# =============================================================
# Nigrani AI — Enterprise Backend Environment Configuration
# =============================================================

# Server Binding
HOST=0.0.0.0
PORT=8000

# Centralized Context Timelines (2026 Reference Context)
APP_CURRENT_YEAR=2026
APP_CURRENT_DATE=2026-09-04

# Database Configuration
# Default (Zero-Config SQLite async for demo/MVP):
DATABASE_URL=sqlite+aiosqlite:///./nigrani.db
# PostgreSQL (Production cloud database):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nigrani_ai

# CORS (Comma-separated allowed origins)
CORS_ORIGINS=https://pramendra0001.github.io,http://localhost:5173,http://127.0.0.1:5173

# Application Operating Mode
# DEMO_MODE=true: populates and benchmarks against 500-project realistic test dataset
# DEMO_MODE=false: runs purely on production database tables and ingested tender feeds
DEMO_MODE=true

# Environment Profile (production / development / test)
ENVIRONMENT=production

# Authentication & Cryptographic Security (Generate with: openssl rand -hex 32)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Strict Production Guard: must remain false in production to prevent OTP exposure
ALLOW_SANDBOX_OTP=false

# Google OAuth Integration (Optional: Real Google Cloud Console Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Dispatch Gateway (Optional: Falls back to instant sandbox OTP if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS Dispatch Gateway (Optional: Twilio / CDAC / Government SMS Gateway)
SMS_GATEWAY_URL=
SMS_API_KEY=

# AI Provider: 'mock' for offline deterministic forensic engine, or 'gemini' for live Gemini API
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Risk Engine Weights (Sum must equal 1.0)
COST_RISK_WEIGHT=0.35
DUPLICATE_RISK_WEIGHT=0.30
DELAY_RISK_WEIGHT=0.25
DATA_QUALITY_RISK_WEIGHT=0.10

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
