# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite default; PostgreSQL connection string can be provided)
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./nigrani.db
# PostgreSQL (Optional production persistence):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nigrani_ai

# CORS (Comma-separated origins)
CORS_ORIGINS=https://pramendra0001.github.io,http://localhost:5173,http://127.0.0.1:5173

# Application Mode
DEMO_MODE=true

# AI Provider: 'mock' for offline deterministic SIH demo, or 'gemini' for live Gemini API
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Risk Engine Weights (Sum must equal 1.0)
COST_RISK_WEIGHT=0.35
DUPLICATE_RISK_WEIGHT=0.30
DELAY_RISK_WEIGHT=0.25
DATA_QUALITY_RISK_WEIGHT=0.10
