# =============================================================
# Nigrani AI — Enterprise Backend Environment Configuration
# =============================================================

# -------------------------------------------------------------
# 1. SERVER BINDING & ENVIRONMENT PROFILE
# -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Set to 'production' for live cloud deployment (Render), or 'development' for local coding
ENVIRONMENT=production

# Strict Security Guard: MUST remain false in production to prevent OTP exposure
# Only set to true when ENVIRONMENT=development for local testing without real gateways
ALLOW_SANDBOX_OTP=false

# Centralized Context Timelines (2026 Reference Baseline)
APP_CURRENT_YEAR=2026
APP_CURRENT_DATE=2026-09-04

# -------------------------------------------------------------
# 2. POSTGRESQL DATABASE PERSISTENCE
# -------------------------------------------------------------
# Default (Zero-Config SQLite async for local dev/MVP):
DATABASE_URL=sqlite+aiosqlite:///./nigrani.db

# Production Cloud Database (Render PostgreSQL):
# Format: postgresql+asyncpg://<username>:<password>@<host>:5432/<database_name>
# Note: Nigrani AI automatically converts postgres:// or postgresql:// to asyncpg driver
# DATABASE_URL=postgresql+asyncpg://user:password@dpg-xxxx.render.com:5432/nigrani_ai

# -------------------------------------------------------------
# 3. CORS CONFIGURATION
# -------------------------------------------------------------
# Comma-separated list of allowed web origins
CORS_ORIGINS=https://pramendra0001.github.io,http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------
# 4. AUTHENTICATION & CRYPTOGRAPHIC SECURITY
# -------------------------------------------------------------
# Secure 256-bit entropy secret key. Generate on your machine with: openssl rand -hex 32
SECRET_KEY=

# Token Expiry & Security Policy
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# -------------------------------------------------------------
# 5. REAL SMS OTP GATEWAY (MSG91 / Twilio)
# -------------------------------------------------------------
# Primary India-focused SMS Provider: 'msg91' (default) or 'twilio'
SMS_PROVIDER=msg91

# MSG91 Official OTP API Configuration:
# Obtain from https://control.msg91.com (Dashboard -> OTP Service)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Optional Twilio Provider Configuration:
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# -------------------------------------------------------------
# 6. REAL EMAIL OTP GATEWAY (SMTP)
# -------------------------------------------------------------
# Standard SMTP credentials for dispatching email verification codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# -------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 INTEGRATION
# -------------------------------------------------------------
# Obtain from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
# Authorized JavaScript Origin: https://pramendra0001.github.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------
# 8. OPERATIONAL MODE & RISK ENGINES
# -------------------------------------------------------------
# DEMO_MODE=true: bootstraps 500 realistic benchmark infrastructure projects across 10 states
# DEMO_MODE=false: operates purely against live database records and ingested tender feeds
DEMO_MODE=true

# AI Provider: 'mock' for deterministic offline anomaly detection, or 'gemini' for live GenAI
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Deterministic Risk Engine Weights (Sum must equal 1.0)
COST_RISK_WEIGHT=0.35
DUPLICATE_RISK_WEIGHT=0.30
DELAY_RISK_WEIGHT=0.25
DATA_QUALITY_RISK_WEIGHT=0.10

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
