# =============================================================
# Nigrani AI — Frontend Client Environment Configuration
# =============================================================

# Production Public Backend URL (Render Cloud API)
# In production, points to the live FastAPI backend:
VITE_API_BASE_URL=https://nigrani-ai-u7gz.onrender.com

# For local development with Vite proxy, leave blank or set to:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Client ID (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
# Required for real Google Sign-In button popup on GitHub Pages
VITE_GOOGLE_CLIENT_ID=

# Application Operational Baseline Year
VITE_APP_YEAR=2026
