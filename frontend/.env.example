# Production Public Backend URL (e.g. Render / Railway / Cloud)
# Format: https://nigrani-ai-u7gz.onrender.com
# For local dev using Vite proxy, leave empty or set to http://127.0.0.1:8000
VITE_API_BASE_URL=https://nigrani-ai-u7gz.onrender.com

# Google OAuth 2.0 Client ID (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
# Optional: The platform includes simulated instant demo sign-in if left blank.
VITE_GOOGLE_CLIENT_ID=

# Application Operational Year Constant
VITE_APP_YEAR=2026
